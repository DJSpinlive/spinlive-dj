{
  "name": "yoris-web",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:no-turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky install || exit 0",
    "format": "prettier --write .",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON \"yarn dev:no-turbo\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && node scripts/copy-standalone-assets.js && electron-builder"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.5.1",
    "@sentry/nextjs": "^9.22.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.7.0",
    "gsap": "^3.13.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "livekit-client": "^2.20.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.24",
    "next": "^15.3.8",
    "next-pwa": "^5.6.0",
    "react": "19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.55.0",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "recharts": "^3.0.2",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "3.4.15",
    "ua-parser-js": "^2.0.4",
    "uuid": "^11.1.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@next/eslint-plugin-next": "^15.3.5",
    "@types/google.maps": "^3.58.1",
    "@types/js-cookie": "^3.0.6",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^20",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.19.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "commitlint": "^19.6.1",
    "concurrently": "^10.0.3",
    "critters": "^0.0.25",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "8.0.3",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.6",
    "prettier": "3.8.2",
    "sass": "^1.83.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "resolutions": {
    "minimatch": "^5.1.0"
  },
  "build": {
    "appId": "com.spinlive.dj",
    "productName": "SpinLive DJ",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "postcss.config.js": [
      "prettier --write"
    ],
    "tailwind.config.js": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
